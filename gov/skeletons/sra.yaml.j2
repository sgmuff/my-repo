# Security assessment under one law. Set kind first: gdpr-art32 | ccpa-audit-prep | coppa-security | hipaa | glba | nis2.
# gov/rules/security.yaml lists the elements each kind must address; gov validate names any the record leaves out.
# Map each element to controls in the library (CTL-NNNN) and their evidence (EV-NNNN). Run `gov validate` then
# `gov render`. Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: sra
schema_version: 1
format_version: 1
kind: gdpr-art32  # set with gov new --kind
title: {{ title | tojson }}
status: Draft
version: "0.1"
activity: TBC  # ROPA-NNNN, or not-applicable for a company-wide program
scope: {systems: TBC, data: TBC, entities: TBC}
period: none  # the period assessed, such as a CCPA audit year
business_owner: TBC
system_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"  # at least annually for coppa-security
summary: TBC  # 50 words at most
decision: {value: open, status: Provisional, reason: Elements not yet assessed}  # adequate | gaps | not-adequate | open
analysis: TBC  # 400 words at most; use |- for paragraphs
criteria: "risk-method.md: likelihood and severity, rated from the shared matrix"

elements: []  # one row per element for the kind: {element, applicability: applies | not-applicable | TBC, reason, controls: [CTL-NNNN], evidence: [EV-NNNN], status: met | partial | gap | TBC}
risks: []

facts: []
context: []
issues: []
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Assessment approved
    approver_role: Approver for the current residual rating (approvals.md), with the security owner
    name: null
    date: null
    outcome: null
