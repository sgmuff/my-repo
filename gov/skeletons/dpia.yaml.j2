# DPIA for one processing activity. Answer the assessment first, then fill this in from the answer, and run
# `gov validate` then `gov render`. gov computes every rating from likelihood and severity; don't type ratings.
# Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: dpia
schema_version: 1
format_version: 1
kind: controller  # controller (GDPR Art. 35) | us-assessment (the GDPR doesn't apply)
title: {{ title | tojson }}
status: Draft
version: "0.1"
activity: TBC  # the RoPA entry, ROPA-NNNN
screening: TBC  # the screening record, SCR-YYYY-NNN
business_owner: TBC
system_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"
summary: TBC  # 50 words at most
decision: {value: open, status: Provisional, reason: Assessment not yet complete}  # proceed | proceed-with-conditions | prior-consultation | do-not-proceed | open
analysis: TBC  # 400 words at most: the full analysis with citations, the provisional view and why, and what would change it

processing:  # Art. 35(7)(a); the RoPA entry holds the inventory
  nature: TBC
  scope: TBC  # whose data, how many people, how much, how long, where
  context: TBC
  purposes: TBC
  special_category: {value: TBC, status: Provisional, reason: Not yet assessed}
  children: {value: TBC, status: Provisional, reason: Not yet assessed}

necessity:  # Art. 35(7)(b); position: adequate | gap | not-met | not-applicable | TBC; link: LIA-..., TIA-..., or none
  - {principle: lawful-basis, position: TBC, basis: TBC, gap: TBC, link: none}
  - {principle: minimization, position: TBC, basis: TBC, gap: TBC, link: none}
  - {principle: purpose-limitation, position: TBC, basis: TBC, gap: TBC, link: none}
  - {principle: transparency, position: TBC, basis: TBC, gap: TBC, link: none}
  - {principle: rights, position: TBC, basis: TBC, gap: TBC, link: none}
  - {principle: retention, position: TBC, basis: TBC, gap: TBC, link: none}

risks: []  # {id: R1, risk, inherent: {likelihood: remote|possible|probable, severity: minimal|significant|severe}, current: {...}, target: {...}, measures: [{measure, status: verified|unverified|planned|absent, evidence}], owner}

consultation:
  dpo: TBC
  data_subjects: TBC
  prior_consultation: {value: TBC, status: Provisional, reason: Depends on the current residual rating}

other_regimes: []  # {regime: uk-gdpr|ch-fadp|us-states|cppa|ferpa|coppa|eu-ai-act, applies: {value, status, reason}, elements}

facts: []  # the fact register: {id: F1, fact, status: confirmed|stated-by-requester|stated-by-vendor|assumption|TBC, source: {kind, ref}}
context: []  # tags from gov/rules/issues.yaml context_tags
issues: []
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Residual risk accepted and processing approved
    approver_role: Set by the current residual rating (approvals.md)
    name: null
    date: null
    outcome: null
