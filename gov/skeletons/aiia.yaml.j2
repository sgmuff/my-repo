# AI impact assessment, FRIA, or FRIA input pack. Answer first, then fill this in from the answer, and run
# `gov validate` then `gov render`. gov computes every risk rating. Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: aiia
schema_version: 1
format_version: 1
kind: aiia  # aiia | fria (the company is the deployer that owes one) | fria-input-pack (for customers' own FRIAs)
title: {{ title | tojson }}
status: Draft
version: "0.1"
system: TBC  # the AI inventory entry, AIS-NNNN
related: {dpia: none, vendor_review: none, aiia: none, fria: none}  # aiia: the assessment a FRIA draws on; fria: an assessment's FRIA
business_owner: TBC
system_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"
summary: TBC  # 50 words at most
decision: {value: open, status: Provisional, reason: Evidence not yet reviewed}  # proceed | proceed-with-conditions | do-not-proceed | open
analysis: TBC  # 400 words at most
tier: TBC  # 1 | 2 | TBC, from ai-intake
ai_act:
  company_role: {value: TBC, status: Provisional, reason: Not yet assessed}  # provider | deployer | provider-and-deployer | not-applicable | TBC
  classification: TBC  # by documented function, with the Annex point
  prohibited: {value: TBC, status: Provisional, reason: Documented function not yet checked against Art. 5}

domains:  # for kind aiia; position: adequate | gap | not-met | not-applicable | TBC; for a FRIA, set domains: []
  - {domain: fairness, position: TBC, evidence: TBC, citations: TBC}
  - {domain: transparency, position: TBC, evidence: TBC, citations: TBC}
  - {domain: human-oversight, position: TBC, evidence: TBC, citations: TBC}
  - {domain: data-provenance, position: TBC, evidence: TBC, citations: TBC}
  - {domain: reliability, position: TBC, evidence: TBC, citations: TBC}
  - {domain: safety, position: TBC, evidence: TBC, citations: TBC}
  - {domain: security, position: TBC, evidence: TBC, citations: TBC}
  - {domain: accountability, position: TBC, evidence: TBC, citations: TBC}
  - {domain: society, position: TBC, evidence: TBC, citations: TBC}

risks: []  # {id: R1, risk, inherent: {likelihood, severity}, current: {...}, target: {...}, measures: [{measure, status, evidence}], owner}

fria:  # for a FRIA or input pack, set applicable: true and fill in (a) to (f)
  applicable: false

facts: []
context: []
issues: []
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Residual risk accepted and use approved
    approver_role: Set by the current residual rating (approvals.md)
    name: null
    date: null
    outcome: null
