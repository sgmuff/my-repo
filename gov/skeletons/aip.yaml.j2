# AI Act provider file for one AI system. Answer the question first, then fill this in from the answer,
# and run `gov validate` then `gov render`. Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: aip
schema_version: 1
format_version: 1
kind: high-risk  # high-risk | non-high-risk (Annex III, Art. 6(3)) | outside-scope (neither annex)
title: {{ title | tojson }}
status: Draft
version: "0.1"
system: TBC  # the AI inventory entry, AIS-NNNN
activity: TBC  # the RoPA entry, ROPA-NNNN, or not-applicable
business_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"
summary: TBC  # 50 words at most
decision: {value: open, status: Provisional, reason: Classification not yet confirmed}  # not-high-risk | ready | gaps | open
analysis: TBC  # 400 words at most: the full legal analysis with citations, the provisional view and why, and what would change it

classification:  # Art. 6
  intended_purpose: TBC
  route: TBC  # annex-i | annex-iii | none | TBC
  annex_point: TBC  # such as Annex III point 4(a)
  art6_3_condition: TBC  # narrow-procedural-task | improves-completed-human-activity | detects-patterns-without-replacing-assessment | preparatory-task | none | not-applicable | TBC
  profiling: {value: TBC, status: Provisional, reason: Not yet assessed}  # profiling of natural persons makes an Annex III system high-risk
  call: {value: TBC, status: Provisional, reason: Not yet assessed}  # is it high-risk?
application_date: TBC  # such as 2027-12-02 for Annex III, with the source checked

obligations:  # one row per article: {article, status: in-place|planned|gap|not-applicable|TBC, evidence, owner}
  - {article: art9, status: TBC, evidence: TBC, owner: TBC}
  - {article: art10, status: TBC, evidence: TBC, owner: TBC}
  - {article: art11, status: TBC, evidence: TBC, owner: TBC}
  - {article: art12, status: TBC, evidence: TBC, owner: TBC}
  - {article: art13, status: TBC, evidence: TBC, owner: TBC}
  - {article: art14, status: TBC, evidence: TBC, owner: TBC}
  - {article: art15, status: TBC, evidence: TBC, owner: TBC}
  - {article: art17, status: TBC, evidence: TBC, owner: TBC}
  - {article: art43, status: TBC, evidence: TBC, owner: TBC}
  - {article: art47-49, status: TBC, evidence: TBC, owner: TBC}
  - {article: art72, status: TBC, evidence: TBC, owner: TBC}
  - {article: art73, status: TBC, evidence: TBC, owner: TBC}

context: []  # tags from gov/rules/issues.yaml context_tags
issues: []  # gov validate lists the issues to address: {issue, status: addressed|not-applicable|open, note}
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
