# Transfer screen: a restricted transfer covered by adequacy, including a DPF certification, needs no
# TIA. Record what was checked, and run `gov validate` then `gov render`. If the screen finds an Art. 46
# tool is relied on, set decision tia-needed and start a TIA. Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: tsr
schema_version: 1
format_version: 1
kind: adequacy
title: {{ title | tojson }}
status: Draft
version: "0.1"
activity: TBC  # the RoPA entry, ROPA-NNNN
vendor_review: TBC
business_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"
summary: TBC  # 50 words at most
decision: {value: open, status: Provisional, reason: Certification not yet checked}  # no-tia-needed | tia-needed | open
analysis: TBC  # 400 words at most: the full legal analysis with citations, every regime and country involved, the provisional view and why, and what would change it
regimes: [eu-gdpr]  # eu-gdpr | uk-gdpr | ch-fadp

exporter: {name: TBC, role: TBC, source: {kind: tbc}}
importer: {name: TBC, country: TBC, role: TBC, source: {kind: tbc}}  # name: the exact legal entity

mechanism:
  route: TBC  # eu-us-dpf | uk-extension | swiss-us-dpf | adequacy-decision | TBC
  certification: {entity: TBC, status: TBC, scope: TBC, checked: TBC}  # status: active | inactive | not-listed; scope: hr | non-hr | hr-and-non-hr
  fallback: TBC  # any SCCs kept as a fallback, or none
onward: TBC  # the provider's sub-processors and countries, and who owes the onward-transfer duty

context: []  # tags from gov/rules/issues.yaml context_tags
issues: []  # gov validate lists the issues to address: {issue, status: addressed|not-applicable|open, note}
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Screen approved
    approver_role: Privacy lead
    name: null
    date: null
    outcome: null
