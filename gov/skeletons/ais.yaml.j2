# AI inventory entry for one AI system, model, agent, or AI feature. Classify by documented function, not labels.
# Tiers and factors: ai-intake/references/tiering.md. Run `gov validate` then `gov render`. Text with a comma inside
# {...} goes in quotes.
id: {{ id }}
type: ais
schema_version: 1
format_version: 1
kind: system
title: {{ title | tojson }}
status: Draft
version: "0.1"
source: TBC  # in-house | vendor-model | vendor-product | embedded-feature
lifecycle: idea  # idea | pilot | live | retired
business_owner: TBC
system_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"  # 6 months for Tiers 1 and 2, 12 for Tier 3
summary: TBC  # 50 words at most: what it does, for whom, with what data, how much it acts on its own
decision: {value: open, status: Provisional, reason: Facts not yet gathered}  # proceed-to-follow-ons | stop | open
analysis: TBC  # 400 words at most: Art. 3(1), roles, each Art. 5 practice, Annex III, Art. 50, GPAI, other regimes; use |- for paragraphs
tier: {value: TBC, status: Provisional, reason: Factors not yet assessed}  # "0" | "1" | "2" | "3"
ai_act:
  ai_system: {value: TBC, status: Provisional, reason: Function not yet documented}
  company_role: {value: TBC, status: Provisional, reason: Facts not yet gathered}  # provider | deployer | provider-and-deployer | not-applicable
  category: {value: TBC, status: Provisional, reason: Function not yet documented}  # prohibited | high-risk | transparency | minimal | not-ai
  annex_point: TBC  # such as Annex III point 4(a), or none
  prohibited: {value: TBC, status: Provisional, reason: Each Art. 5 practice not yet checked}
autonomy: TBC  # L0-suggest | L1-act-with-approval | L2-act-within-limits | L3-act-broadly
decisions_about_people: TBC  # none | informs | decides
personal_data: TBC  # none | personal | sensitive
aiuc:
  mode: not-applicable  # readiness (own agent) | benchmark (vendor's agent) | not-applicable
  certification: none  # vendor: product in scope, release, report date, expiry
  capabilities: []  # External-facing | Automation | Code-generation | Text-generation | Voice-generation | Image-generation; Universal always applies

use:
  inputs: TBC
  outputs: TBC
  output_use: TBC
  users: TBC
  subjects: TBC
  tools: TBC
  model: TBC

data: []  # {data, sensitivity: none | personal | sensitive, source, retention}

tiering:  # level "0" to "3" per factor, with the fact behind it; the tier is the highest level
  - {factor: ai-act-use, level: TBC, fact: TBC}
  - {factor: decisions-about-people, level: TBC, fact: TBC}
  - {factor: people-affected, level: TBC, fact: TBC}
  - {factor: data, level: TBC, fact: TBC}
  - {factor: autonomy, level: TBC, fact: TBC}
  - {factor: reach-and-reversibility, level: TBC, fact: TBC}
  - {factor: source, level: TBC, fact: TBC}

top_risks: []  # three to six, from risk-method.md section 2a, with who is affected

follow_ons: []  # {follow_on: ai-impact-assessment | dpia-screening | vendor-review | aup | ai-act-provider | ai-act-deployer | aiuc-readiness, why, status: recommended | in-progress | done | not-needed, record: none}

containment: []  # {control, owner, applied, evidence, downstream_stopped: true | false | TBC, remaining_paths, reenable_when}

related:
  ropa: none
  vendor_review: none

facts: []
context: []
issues: []
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Facts confirmed
    approver_role: Business owner
    name: null
    date: null
    outcome: null
  - decision: Tier and classification confirmed
    approver_role: Privacy lead
    name: null
    date: null
    outcome: null
