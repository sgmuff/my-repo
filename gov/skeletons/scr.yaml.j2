# DPIA screening record. Answer the screening question first, then fill this in from the answer, and run
# `gov validate` then `gov render`. `gov screen <RoPA record>` lists the criteria the RoPA's facts suggest.
# Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: scr
schema_version: 1
format_version: 1
kind: screening
title: {{ title | tojson }}
status: Draft
version: "0.1"
activity: TBC  # the RoPA entry, ROPA-NNNN
business_owner: TBC
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"
summary: TBC  # 50 words at most
decision: {value: open, status: Provisional, reason: Not yet screened}  # warranted | recommended | not-indicated | open
analysis: TBC  # 400 words at most: territorial scope, the criteria that drive the call and their facts, the provisional view and what would change it

regimes:  # one row per regime screened; applies: is it in scope for this activity
  - {regime: eu-gdpr, applies: {value: TBC, status: Provisional, reason: Establishment and targeting not yet confirmed}, result: TBC}
art35_3:  # cases where a DPIA is always required
  a_systematic_evaluation: {value: TBC, status: Provisional, reason: Not yet assessed}
  b_large_scale_special_category: {value: TBC, status: Provisional, reason: Not yet assessed}
  c_public_monitoring: {value: TBC, status: Provisional, reason: Not yet assessed}
criteria:  # the nine EDPB criteria; result: present | not-present | unclear; facts: with fact IDs and whether confirmed
{% for n in range(1, 10) %}  - {criterion: {{ n }}, result: unclear, facts: TBC}
{% endfor %}national_list: {authority: TBC, result: unclear, item: TBC}  # the lead authority's Art. 35(4) list; result: listed | not-listed | unclear | not-applicable
state_assessment: {required: {value: TBC, status: Provisional, reason: State thresholds not yet checked}, states: TBC}

facts: []  # the fact register: {id: F1, fact, status: confirmed|stated-by-requester|stated-by-vendor|assumption|TBC, source: {kind, ref}}
context: []  # tags from gov/rules/issues.yaml context_tags
issues: []
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Screening outcome approved
    approver_role: Privacy lead
    name: null
    date: null
    outcome: null
