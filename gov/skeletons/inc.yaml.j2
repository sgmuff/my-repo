# Incident assessment. Record the awareness time first; gov computes the statutory clocks from it, the regimes, and
# the states, and renders them at the top. Then fill in the rest from your answer, and run `gov validate` then
# `gov render`, which also writes the notice drafts. Text with a comma inside {...} goes in quotes.
id: {{ id }}
type: inc
schema_version: 1
format_version: 1
kind: incident
title: {{ title | tojson }}
status: Draft
version: "0.1"
awareness: {time: TBC, tz: UTC, reasoning: TBC, confirmed: false}  # time: YYYY-MM-DDTHH:MM in tz; confirmed once the commander confirms it
started: TBC
ongoing: {value: TBC, status: Provisional, reason: Not yet confirmed}
regimes: []  # gdpr | uk | fadp | nydfs | ny2d | sec | ftc-glba: every one that could apply
states: []  # two-letter codes where affected people live
individual_notice: TBC  # YYYY-MM-DD, for regulator deadlines that run from it
commander: TBC  # the one incident commander
prepared_by: {{ prepared_by | tojson }}
date_prepared: "{{ date }}"
last_reviewed: null
next_review: "{{ next_review }}"
summary: TBC  # 50 words at most
decision: {value: undetermined, status: Provisional, reason: Facts still being gathered}  # notify | notify-some | no-notice-required | undetermined
analysis: TBC  # 400 words at most; use |- for paragraphs

datasets:  # role: controller | processor | maintainer | school-official | TBC
  - {dataset: TBC, elements: TBC, people: TBC, residence: TBC, role: TBC, acquired: {value: TBC, status: Provisional, reason: Not yet known}, encrypted: {value: TBC, status: Provisional, reason: Not yet known}}
breach: {value: TBC, status: Provisional, reason: Not yet assessed}

matrix: []  # one row per recipient: {recipient, regime, required: {value, status, reason}, basis, deadline, deadline_kind: statutory | contractual | none, owner, status: not-started | drafting | awaiting-approval | sent | delivered | not-required, sent}
notices: []  # {recipient, text}: drafts, rendered with DRAFT: not sent
decisions: []  # the decision log, made by people: {time, decision, by, evidence, rationale}
containment: []  # owned by security: {measure, status: done-verified | done-unverified | in-progress | not-started, evidence}
closure: {closed: TBC, root_cause: TBC, follow_ons: TBC}

facts: []  # with the time each fact was learned in its source
context: []
issues: []
actions: []
open_questions: []
verify: []
finding_responses: []
references: []

version_history:
  - version: "0.1"
    date: "{{ date }}"
    author: {{ prepared_by | tojson }}
    change: First draft

signoff:
  - decision: Notification decisions recorded
    approver_role: Counsel and the privacy lead (approvals.md)
    name: null
    date: null
    outcome: null
